{
    "$schema": "../validation-test-schema.json",
    "description": "pattern validation",
    "tests": [
        {
            "description": "pattern validation",
            "schema": { "pattern": "^a*$" },
            "tests": [
                {
                    "description": "a matching pattern is valid",
                    "data": "aaa",
                    "valid": true
                },
                {
                    "description": "a non-matching pattern is invalid",
                    "data": "abc",
                    "valid": false
                },
                {
                    "description": "ignores booleans",
                    "data": true,
                    "valid": true
                },
                {
                    "description": "ignores integers",
                    "data": 123,
                    "valid": true
                },
                {
                    "description": "ignores floats",
                    "data": 1.0,
                    "valid": true
                },
                {
                    "description": "ignores objects",
                    "data": {},
                    "valid": true
                },
                {
                    "description": "ignores arrays",
                    "data": [],
                    "valid": true
                },
                {
                    "description": "ignores null",
                    "data": null,
                    "valid": true
                }
            ]
        },
        {
            "description": "pattern is not anchored",
            "schema": { "pattern": "a+" },
            "tests": [
                {
                    "description": "matches a substring",
                    "data": "xxaayy",
                    "valid": true
                }
            ]
        },
        {
            "description": "pattern with Unicode property escape requires unicode mode",
            "compatibility": "2020",
            "schema": {
                "type": "string",
                "pattern": "^\\p{Letter}+$"
            },
            "tests": [
                {
                    "description": "ASCII letters match",
                    "data": "Hello",
                    "valid": true
                },
                {
                    "description": "Non-ASCII letters match",
                    "data": "π",
                    "valid": true
                },
                {
                    "description": "Digits do not match",
                    "data": "123",
                    "valid": false
                }
            ]
        },
        {
            "description": "pattern with Unicode property escape",
            "compatibility": "2020",
            "schema": {
                "type": "string",
                "pattern": "^\\p{Letter}+$"
            },
            "tests": [
                {
                    "description": "a valid case with a Unicode letter",
                    "data": "π",
                    "valid": true
                },
                {
                    "description": "another valid case with multiple Unicode letters",
                    "data": "πλ",
                    "valid": true
                },
                {
                    "description": "an invalid case where the string contains digits",
                    "data": "123",
                    "valid": false
                }
            ]
        },
        {
            "description": "pattern $ does not match before a trailing newline",
            "compatibility": "9999",
            "schema": {
                "type": "string",
                "pattern": "^abc$"
            },
            "tests": [
                {
                    "description": "matches",
                    "data": "abc",
                    "valid": true
                },
                {
                    "description": "a trailing newline does not match",
                    "data": "abc\n",
                    "valid": false
                }
            ]
        },
        {
            "description": "pattern . does not match line terminators",
            "compatibility": "9999",
            "schema": {
                "type": "string",
                "pattern": "^.$"
            },
            "tests": [
                {
                    "description": "any other character matches",
                    "data": "a",
                    "valid": true
                },
                {
                    "description": "line feed does not match",
                    "data": "\n",
                    "valid": false
                },
                {
                    "description": "carriage return does not match",
                    "data": "\r",
                    "valid": false
                },
                {
                    "description": "line separator does not match",
                    "data": "\u2028",
                    "valid": false
                },
                {
                    "description": "paragraph separator does not match",
                    "data": "\u2029",
                    "valid": false
                }
            ]
        }
    ]
}
