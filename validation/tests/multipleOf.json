{
    "$schema": "../validation-test-schema.json",
    "description": "multipleOf validation",
    "tests": [
        {
            "description": "multipleOf int",
            "compatibility": "4",
            "schema": {
                "multipleOf": 2
            },
            "tests": [
                {
                    "description": "int by int",
                    "data": 10,
                    "valid": true
                },
                {
                    "description": "int by int fail",
                    "data": 7,
                    "valid": false
                },
                {
                    "description": "ignores non-numbers",
                    "data": "foo",
                    "valid": true
                }
            ]
        },
        {
            "description": "divisibleby int",
            "compatibility": "=3",
            "schema": {
                "divisibleBy": 2
            },
            "tests": [
                {
                    "description": "int by int",
                    "data": 10,
                    "valid": true
                },
                {
                    "description": "int by int fail",
                    "data": 7,
                    "valid": false
                },
                {
                    "description": "ignores non-numbers",
                    "data": "foo",
                    "valid": true
                }
            ]
        },
        {
            "description": "multipleOf number",
            "compatibility": "4",
            "schema": {
                "multipleOf": 1.5
            },
            "tests": [
                {
                    "description": "zero is multiple of anything",
                    "data": 0,
                    "valid": true
                },
                {
                    "description": "4.5 is multiple of 1.5",
                    "data": 4.5,
                    "valid": true
                },
                {
                    "description": "-4.5 is multiple of 1.5",
                    "data": -4.5,
                    "valid": true
                },
                {
                    "description": "35 is not multiple of 1.5",
                    "data": 35,
                    "valid": false
                }
            ]
        },
        {
            "description": "divisibleBy number",
            "compatibility": "=3",
            "schema": {
                "divisibleBy": 1.5
            },
            "tests": [
                {
                    "description": "zero is divisible by anything (except 0)",
                    "data": 0,
                    "valid": true
                },
                {
                    "description": "4.5 is divisible by 1.5",
                    "data": 4.5,
                    "valid": true
                },
                {
                    "description": "-4.5 is divisible by 1.5",
                    "data": -4.5,
                    "valid": true
                },
                {
                    "description": "35 is not divisible by 1.5",
                    "data": 35,
                    "valid": false
                }
            ]
        },
        {
            "description": "multipleOf small number",
            "compatibility": "4",
            "schema": {
                "multipleOf": 0.0001
            },
            "tests": [
                {
                    "description": "0.0075 is multiple of 0.0001",
                    "data": 0.0075,
                    "valid": true
                },
                {
                    "description": "0.00751 is not multiple of 0.0001",
                    "data": 0.00751,
                    "valid": false
                }
            ]
        },
        {
            "description": "divisibleBy small number",
            "compatibility": "=3",
            "schema": {
                "divisibleBy": 0.0001
            },
            "tests": [
                {
                    "description": "0.0075 is divisible by 0.0001",
                    "data": 0.0075,
                    "valid": true
                },
                {
                    "description": "0.00751 is not divisible by 0.0001",
                    "data": 0.00751,
                    "valid": false
                }
            ]
        },
        {
            "description": "multipleOf very small number",
            "comment": "A fixed epsilon larger than the divisor (e.g. 32-bit float epsilon) would accept every instance",
            "compatibility": "4",
            "schema": {
                "multipleOf": 1e-8
            },
            "tests": [
                {
                    "description": "4e-8 is multiple of 1e-8",
                    "data": 4e-8,
                    "valid": true
                },
                {
                    "description": "1.5e-8 is not multiple of 1e-8",
                    "data": 1.5e-8,
                    "valid": false
                }
            ]
        },
        {
            "description": "divisibleBy very small number",
            "comment": "A fixed epsilon larger than the divisor (e.g. 32-bit float epsilon) would accept every instance",
            "compatibility": "=3",
            "schema": {
                "divisibleBy": 1e-8
            },
            "tests": [
                {
                    "description": "4e-8 is divisible by 1e-8",
                    "data": 4e-8,
                    "valid": true
                },
                {
                    "description": "1.5e-8 is not divisible by 1e-8",
                    "data": 1.5e-8,
                    "valid": false
                }
            ]
        },
        {
            "description": "multipleOf instance very close to a multiple",
            "comment": "Each invalid instance is a different double from 8.75, but a fixed epsilon of 1e-11 or more (e.g. 1e-10), or rounding to 11 decimal places, would accept it",
            "compatibility": "4",
            "schema": {
                "multipleOf": 0.25
            },
            "tests": [
                {
                    "description": "8.75 is multiple of 0.25",
                    "data": 8.75,
                    "valid": true
                },
                {
                    "description": "8.750000000001 is not multiple of 0.25",
                    "data": 8.750000000001,
                    "valid": false
                },
                {
                    "description": "8.7500000000001 is not multiple of 0.25",
                    "data": 8.7500000000001,
                    "valid": false
                },
                {
                    "description": "8.75000000000001 is not multiple of 0.25",
                    "data": 8.75000000000001,
                    "valid": false
                }
            ]
        },
        {
            "description": "divisibleBy instance very close to a multiple",
            "comment": "Each invalid instance is a different double from 8.75, but a fixed epsilon of 1e-11 or more (e.g. 1e-10), or rounding to 11 decimal places, would accept it",
            "compatibility": "=3",
            "schema": {
                "divisibleBy": 0.25
            },
            "tests": [
                {
                    "description": "8.75 is divisible by 0.25",
                    "data": 8.75,
                    "valid": true
                },
                {
                    "description": "8.750000000001 is not divisible by 0.25",
                    "data": 8.750000000001,
                    "valid": false
                },
                {
                    "description": "8.7500000000001 is not divisible by 0.25",
                    "data": 8.7500000000001,
                    "valid": false
                },
                {
                    "description": "8.75000000000001 is not divisible by 0.25",
                    "data": 8.75000000000001,
                    "valid": false
                }
            ]
        },
        {
            "description": "multipleOf when float division = inf",
            "compatibility": "4",
            "schema": {
                "type": "integer",
                "multipleOf": 0.123456789
            },
            "tests": [
                {
                    "description": "invalid, but naive implementations may raise an overflow error",
                    "data": 1e308,
                    "valid": false
                }
            ]
        },
        {
            "description": "divisibleBy when float division = inf",
            "compatibility": "=3",
            "schema": {
                "type": "integer",
                "divisibleBy": 0.123456789
            },
            "tests": [
                {
                    "description": "invalid, but naive implementations may raise an overflow error",
                    "data": 1e308,
                    "valid": false
                }
            ]
        },
        {
            "description": "small multiple of large integer",
            "compatibility": "4",
            "schema": {
                "type": "integer",
                "multipleOf": 1e-8
            },
            "tests": [
                {
                    "description": "any integer is a multiple of 1e-8",
                    "data": 12391239123,
                    "valid": true
                }
            ]
        },
        {
            "description": "large integer divisibleBy a small number",
            "compatibility": "=3",
            "schema": {
                "type": "integer",
                "divisibleBy": 1e-8
            },
            "tests": [
                {
                    "description": "any integer is a multiple of 1e-8",
                    "data": 12391239123,
                    "valid": true
                }
            ]
        }
    ]
}
