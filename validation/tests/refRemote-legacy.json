{
    "$schema": "../validation-test-schema.json",
    "description": "refRemote-legacy validation",
    "tests": [
        {
            "description": "fragment within remote ref",
            "compatibility": "3,<=7",
            "schema": { "$ref": "http://localhost:1234/subSchemas.json#/definitions/integer" },
            "externalSchemas": {
                "http://localhost:1234/subSchemas.json": {
                    "definitions": {
                        "integer": {
                            "type": "integer"
                        }
                    }
                }
            },
            "tests": [
                {
                    "description": "remote fragment valid",
                    "data": 1,
                    "valid": true
                },
                {
                    "description": "remote fragment invalid",
                    "data": "a",
                    "valid": false
                }
            ]
        },
        {
            "description": "ref within remote ref",
            "compatibility": "3,<=7",
            "schema": { "$ref": "http://localhost:1234/subSchemas.json#/definitions/refToInteger" },
            "externalSchemas": {
                "http://localhost:1234/subSchemas.json": {
                    "definitions": {
                        "integer": {
                            "type": "integer"
                        },
                        "refToInteger": {
                            "$ref": "#/definitions/integer"
                        }
                    }
                }
            },
            "tests": [
                {
                    "description": "ref within ref valid",
                    "data": 1,
                    "valid": true
                },
                {
                    "description": "ref within ref invalid",
                    "data": "a",
                    "valid": false
                }
            ]
        },
        {
            "description": "base URI change - change folder",
            "compatibility": "6,<=7",
            "schema": {
                "$id": "http://localhost:1234/scope_change_defs1.json",
                "type" : "object",
                "properties": {
                    "list": { "$ref": "#/definitions/baz" }
                },
                "definitions": {
                    "baz": {
                        "$id": "baseUriChangeFolder/",
                        "type": "array",
                        "items": { "$ref": "folderInteger.json" }
                    }
                }
            },
            "externalSchemas": {
                "http://localhost:1234/baseUriChangeFolder/folderInteger.json": {
                    "type": "integer"
                }
            },
            "tests": [
                {
                    "description": "number is valid",
                    "data": { "list": [1] },
                    "valid": true
                },
                {
                    "description": "string is invalid",
                    "data": { "list": ["a"] },
                    "valid": false
                }
            ]
        },
        {
            "description": "base URI change - change folder in subschema",
            "compatibility": "6,<=7",
            "schema": {
                "$id": "http://localhost:1234/scope_change_defs2.json",
                "type" : "object",
                "properties": {
                    "list": { "$ref": "#/definitions/baz/definitions/bar" }
                },
                "definitions": {
                    "baz": {
                        "$id": "baseUriChangeFolderInSubschema/",
                        "definitions": {
                            "bar": {
                                "type": "array",
                                "items": { "$ref": "folderInteger.json" }
                            }
                        }
                    }
                }
            },
            "externalSchemas": {
                "http://localhost:1234/baseUriChangeFolderInSubschema/folderInteger.json": {
                    "type": "integer"
                }
            },
            "tests": [
                {
                    "description": "number is valid",
                    "data": { "list": [1] },
                    "valid": true
                },
                {
                    "description": "string is invalid",
                    "data": { "list": ["a"] },
                    "valid": false
                }
            ]
        },
        {
            "description": "root ref in remote ref",
            "compatibility": "6,<=7",
            "schema": {
                "$id": "http://localhost:1234/object",
                "type": "object",
                "properties": {
                    "name": { "$ref": "draft6/name.json#/definitions/orNull" }
                }
            },
            "externalSchemas": {
                "http://localhost:1234/name.json": {
                    "definitions": {
                        "orNull": {
                            "anyOf": [
                                { "type": "null" },
                                { "$ref": "#" }
                            ]
                        }
                    },
                    "type": "string"
                }
            },
            "tests": [
                {
                    "description": "string is valid",
                    "data": { "name": "foo" },
                    "valid": true
                },
                {
                    "description": "null is valid",
                    "data": { "name": null },
                    "valid": true
                },
                {
                    "description": "object is invalid",
                    "data": { "name": { "name": null } },
                    "valid": false
                }
            ]
        },
        {
            "description": "remote ref with ref to definitions",
            "compatibility": "6,<=7",
            "schema": {
                "$id": "http://localhost:1234/schema-remote-ref-ref-defs1.json",
                "allOf": [{ "$ref": "ref-and-definitions.json" }]
            },
            "externalSchemas": {
                "http://localhost:1234/ref-and-definitions.json": {
                    "definitions": {
                        "inner": {
                            "properties": {
                                "bar": { "type": "string" }
                            }
                        }
                    },
                    "allOf": [{ "$ref": "#/definitions/inner" }]
                }
            },
            "tests": [
                {
                    "description": "invalid",
                    "data": { "bar": 1 },
                    "valid": false
                },
                {
                    "description": "valid",
                    "data": { "bar": "a" },
                    "valid": true
                }
            ]
        },
        {
            "description": "Location-independent identifier in remote ref",
            "compatibility": "6,<=7",
            "schema": { "$ref": "http://localhost:1234/locationIndependentIdentifier.json#/definitions/refToInteger" },
            "externalSchemas": {
                "http://localhost:1234/locationIndependentIdentifier.json": {
                    "definitions": {
                        "refToInteger": {
                            "$ref": "#foo"
                        },
                        "A": {
                            "$id": "#foo",
                            "type": "integer"
                        }
                    }
                }
            },
            "tests": [
                {
                    "description": "integer is valid",
                    "data": 1,
                    "valid": true
                },
                {
                    "description": "string is invalid",
                    "data": "foo",
                    "valid": false
                }
            ]
        }
    ]
}
