{
    "$schema": "../validation-test-schema.json",
    "description": "$ref legacy validation",
    "tests": [
        {
            "description": "relative pointer ref to array",
            "compatibility": "3,<=2019",
            "schema": {
                "items": [
                    { "type": "integer" },
                    { "$ref": "#/items/0" }
                ]
            },
            "tests": [
                {
                    "description": "match array",
                    "data": [1, 2],
                    "valid": true
                },
                {
                    "description": "mismatch array",
                    "data": [1, "foo"],
                    "valid": false
                }
            ]
        },
        {
            "description": "escaped pointer ref",
            "compatibility": "3,<=7",
            "schema": {
                "definitions": {
                    "tilde~field": { "type": "integer" },
                    "slash/field": { "type": "integer" },
                    "percent%field": { "type": "integer" }
                },
                "properties": {
                    "tilde": { "$ref": "#/definitions/tilde~0field" },
                    "slash": { "$ref": "#/definitions/slash~1field" },
                    "percent": { "$ref": "#/definitions/percent%25field" }
                }
            },
            "tests": [
                {
                    "description": "slash invalid",
                    "data": { "slash": "aoeu" },
                    "valid": false
                },
                {
                    "description": "tilde invalid",
                    "data": { "tilde": "aoeu" },
                    "valid": false
                },
                {
                    "description": "percent invalid",
                    "data": { "percent": "aoeu" },
                    "valid": false
                },
                {
                    "description": "slash valid",
                    "data": { "slash": 123 },
                    "valid": true
                },
                {
                    "description": "tilde valid",
                    "data": { "tilde": 123 },
                    "valid": true
                },
                {
                    "description": "percent valid",
                    "data": { "percent": 123 },
                    "valid": true
                }
            ]
        },
        {
            "description": "nested refs",
            "compatibility": "3,<=7",
            "schema": {
                "definitions": {
                    "a": { "type": "integer" },
                    "b": { "$ref": "#/definitions/a" },
                    "c": { "$ref": "#/definitions/b" }
                },
                "properties": {
                    "foo": { "$ref": "#/definitions/c" }
                }
            },
            "tests": [
                {
                    "description": "nested ref valid",
                    "data": { "foo": 5 },
                    "valid": true
                },
                {
                    "description": "nested ref invalid",
                    "data": { "foo": "a" },
                    "valid": false
                }
            ]
        },
        {
            "description": "ref overrides any sibling keywords",
            "compatibility": "3,<=7",
            "schema": {
                "definitions": {
                    "reffed": { "type": "array" }
                },
                "properties": {
                    "foo": {
                        "$ref": "#/definitions/reffed",
                        "maxItems": 2
                    }
                }
            },
            "tests": [
                {
                    "description": "ref valid",
                    "data": { "foo": [] },
                    "valid": true
                },
                {
                    "description": "ref valid, maxItems ignored",
                    "data": { "foo": [ 1, 2, 3] },
                    "valid": true
                },
                {
                    "description": "ref invalid",
                    "data": { "foo": "string" },
                    "valid": false
                }
            ]
        },
        {
            "description": "property named $ref, containing an actual $ref",
            "compatibility": "3,<=7",
            "schema": {
                "properties": {
                    "$ref": { "$ref": "#/definitions/is-string" }
                },
                "definitions": {
                    "is-string": { "type": "string" }
                }
            },
            "tests": [
                {
                    "description": "property named $ref valid",
                    "data": { "$ref": "a" },
                    "valid": true
                },
                {
                    "description": "property named $ref invalid",
                    "data": { "$ref": 2 },
                    "valid": false
                }
            ]
        },
        {
            "description": "naive replacement of $ref with its destination is not correct",
            "compatibility": "3,<=7",
            "schema": {
                "definitions": {
                    "a_string": { "type": "string" }
                },
                "enum": [{ "$ref": "#/definitions/a_string" }]
            },
            "tests": [
                {
                    "description": "do not evaluate the $ref inside the enum, matching any string",
                    "data": "this is a string",
                    "valid": false
                },
                {
                    "description": "do not evaluate the $ref inside the enum, definition exact match",
                    "data": { "type": "string" },
                    "valid": false
                },
                {
                    "description": "match the enum exactly",
                    "data": { "$ref": "#/definitions/a_string" },
                    "valid": true
                }
            ]
        },
        {
            "description": "$ref to boolean schema true",
            "compatibility": "6,<=7",
            "schema": {
                "allOf": [{ "$ref": "#/definitions/bool" }],
                "definitions": { "bool": true }
            },
            "tests": [
                {
                    "description": "any value is valid",
                    "data": "foo",
                    "valid": true
                }
            ]
        },
        {
            "description": "$ref to boolean schema false",
            "compatibility": "6,<=7",
            "schema": {
                "allOf": [{ "$ref": "#/definitions/bool" }],
                "definitions": { "bool": false }
            },
            "tests": [
                {
                    "description": "any value is invalid",
                    "data": "foo",
                    "valid": false
                }
            ]
        },
        {
            "description": "refs with quote",
            "compatibility": "3,<=7",
            "schema": {
                "properties": {
                    "foo\"bar": { "$ref": "#/definitions/foo%22bar" }
                },
                "definitions": {
                    "foo\"bar": { "type": "number" }
                }
            },
            "tests": [
                {
                    "description": "object with numbers is valid",
                    "data": { "foo\"bar": 1 },
                    "valid": true
                },
                {
                    "description": "object with strings is invalid",
                    "data": { "foo\"bar": "1" },
                    "valid": false
                }
            ]
        },
        {
            "description": "empty tokens in $ref json-pointer",
            "compatibility": "3,<=7",
            "schema": {
                "definitions": {
                    "": {
                        "definitions": {
                            "": { "type": "number" }
                        }
                    }
                },
                "properties": {
                    "foo": { "$ref": "#/definitions//definitions/" }
                }
            },
            "tests": [
                {
                    "description": "number is valid",
                    "data": { "foo": 1 },
                    "valid": true
                },
                {
                    "description": "non-number is invalid",
                    "data": { "foo": "a" },
                    "valid": false
                }
            ]
        },
        {
            "description": "fragment within remote ref",
            "compatibility": "3,<=7",
            "schema": { "$ref": "http://localhost:1234/subSchemas.json#/definitions/integer" },
            "externalSchemas": {
                "http://localhost:1234/subSchemas.json": {
                    "definitions": {
                        "integer": {
                            "type": "integer"
                        }
                    }
                }
            },
            "tests": [
                {
                    "description": "remote fragment valid",
                    "data": 1,
                    "valid": true
                },
                {
                    "description": "remote fragment invalid",
                    "data": "a",
                    "valid": false
                }
            ]
        },
        {
            "description": "ref within remote ref",
            "compatibility": "3,<=7",
            "schema": { "$ref": "http://localhost:1234/subSchemas.json#/definitions/refToInteger" },
            "externalSchemas": {
                "http://localhost:1234/subSchemas.json": {
                    "definitions": {
                        "integer": {
                            "type": "integer"
                        },
                        "refToInteger": {
                            "$ref": "#/definitions/integer"
                        }
                    }
                }
            },
            "tests": [
                {
                    "description": "ref within ref valid",
                    "data": 1,
                    "valid": true
                },
                {
                    "description": "ref within ref invalid",
                    "data": "a",
                    "valid": false
                }
            ]
        },
        {
            "description": "root ref in remote ref",
            "compatibility": "4,<=7",
            "schema": {
                "type": "object",
                "properties": {
                    "name": { "$ref": "http://localhost:1234/name.json#/definitions/orNull" }
                }
            },
            "externalSchemas": {
                "http://localhost:1234/name.json": {
                    "definitions": {
                        "orNull": {
                            "anyOf": [
                                { "type": "null" },
                                { "$ref": "#" }
                            ]
                        }
                    },
                    "type": "string"
                }
            },
            "tests": [
                {
                    "description": "string is valid",
                    "data": { "name": "foo" },
                    "valid": true
                },
                {
                    "description": "null is valid",
                    "data": { "name": null },
                    "valid": true
                },
                {
                    "description": "object is invalid",
                    "data": { "name": { "name": null } },
                    "valid": false
                }
            ]
        },
        {
            "description": "remote ref with ref to definitions",
            "compatibility": "4,<=7",
            "schema": {
                "allOf": [{ "$ref": "http://localhost:1234/ref-and-definitions.json" }]
            },
            "externalSchemas": {
                "http://localhost:1234/ref-and-definitions.json": {
                    "definitions": {
                        "inner": {
                            "properties": {
                                "bar": { "type": "string" }
                            }
                        }
                    },
                    "allOf": [{ "$ref": "#/definitions/inner" }]
                }
            },
            "tests": [
                {
                    "description": "invalid",
                    "data": { "bar": 1 },
                    "valid": false
                },
                {
                    "description": "valid",
                    "data": { "bar": "a" },
                    "valid": true
                }
            ]
        },
        {
            "description": "$ref with a parent directory segment",
            "compatibility": "6,<=7",
            "comment": "RFC 3986 5.2.4: \"..\" removes the last segment of the merged path",
            "schema": {
                "$id": "http://example.com/a/b/c.json",
                "allOf": [
                    {
                        "$ref": "../d.json"
                    }
                ],
                "definitions": {
                    "target": {
                        "$id": "http://example.com/a/d.json",
                        "type": "string"
                    }
                }
            },
            "tests": [
                {
                    "description": "a string is valid",
                    "data": "foo",
                    "valid": true
                },
                {
                    "description": "a non-string is invalid",
                    "data": 1,
                    "valid": false
                }
            ]
        },
        {
            "description": "$ref with a parent directory segment (id)",
            "compatibility": "=4",
            "comment": "RFC 3986 5.2.4: \"..\" removes the last segment of the merged path",
            "schema": {
                "id": "http://example.com/a/b/c.json",
                "allOf": [
                    {
                        "$ref": "../d.json"
                    }
                ],
                "definitions": {
                    "target": {
                        "id": "http://example.com/a/d.json",
                        "type": "string"
                    }
                }
            },
            "tests": [
                {
                    "description": "a string is valid",
                    "data": "foo",
                    "valid": true
                },
                {
                    "description": "a non-string is invalid",
                    "data": 1,
                    "valid": false
                }
            ]
        },
        {
            "description": "$ref with two parent directory segments",
            "compatibility": "6,<=7",
            "schema": {
                "$id": "http://example.com/a/b/c.json",
                "allOf": [
                    {
                        "$ref": "../../d.json"
                    }
                ],
                "definitions": {
                    "target": {
                        "$id": "http://example.com/d.json",
                        "type": "string"
                    }
                }
            },
            "tests": [
                {
                    "description": "a string is valid",
                    "data": "foo",
                    "valid": true
                },
                {
                    "description": "a non-string is invalid",
                    "data": 1,
                    "valid": false
                }
            ]
        },
        {
            "description": "$ref with two parent directory segments (id)",
            "compatibility": "=4",
            "schema": {
                "id": "http://example.com/a/b/c.json",
                "allOf": [
                    {
                        "$ref": "../../d.json"
                    }
                ],
                "definitions": {
                    "target": {
                        "id": "http://example.com/d.json",
                        "type": "string"
                    }
                }
            },
            "tests": [
                {
                    "description": "a string is valid",
                    "data": "foo",
                    "valid": true
                },
                {
                    "description": "a non-string is invalid",
                    "data": 1,
                    "valid": false
                }
            ]
        },
        {
            "description": "$ref ending in a parent directory segment",
            "compatibility": "6,<=7",
            "comment": "RFC 3986 5.2.4: a trailing \"..\" leaves the path ending in \"/\"",
            "schema": {
                "$id": "http://example.com/a/b/c.json",
                "allOf": [
                    {
                        "$ref": "x/.."
                    }
                ],
                "definitions": {
                    "target": {
                        "$id": "http://example.com/a/b/",
                        "type": "string"
                    }
                }
            },
            "tests": [
                {
                    "description": "a string is valid",
                    "data": "foo",
                    "valid": true
                },
                {
                    "description": "a non-string is invalid",
                    "data": 1,
                    "valid": false
                }
            ]
        },
        {
            "description": "$ref ending in a parent directory segment (id)",
            "compatibility": "=4",
            "comment": "RFC 3986 5.2.4: a trailing \"..\" leaves the path ending in \"/\"",
            "schema": {
                "id": "http://example.com/a/b/c.json",
                "allOf": [
                    {
                        "$ref": "x/.."
                    }
                ],
                "definitions": {
                    "target": {
                        "id": "http://example.com/a/b/",
                        "type": "string"
                    }
                }
            },
            "tests": [
                {
                    "description": "a string is valid",
                    "data": "foo",
                    "valid": true
                },
                {
                    "description": "a non-string is invalid",
                    "data": 1,
                    "valid": false
                }
            ]
        },
        {
            "description": "$ref ending in a current directory segment",
            "compatibility": "6,<=7",
            "comment": "RFC 3986 5.2.4: a trailing \".\" leaves the path ending in \"/\"",
            "schema": {
                "$id": "http://example.com/a.json",
                "allOf": [
                    {
                        "$ref": "x/."
                    }
                ],
                "definitions": {
                    "target": {
                        "$id": "http://example.com/x/",
                        "type": "string"
                    }
                }
            },
            "tests": [
                {
                    "description": "a string is valid",
                    "data": "foo",
                    "valid": true
                },
                {
                    "description": "a non-string is invalid",
                    "data": 1,
                    "valid": false
                }
            ]
        },
        {
            "description": "$ref ending in a current directory segment (id)",
            "compatibility": "=4",
            "comment": "RFC 3986 5.2.4: a trailing \".\" leaves the path ending in \"/\"",
            "schema": {
                "id": "http://example.com/a.json",
                "allOf": [
                    {
                        "$ref": "x/."
                    }
                ],
                "definitions": {
                    "target": {
                        "id": "http://example.com/x/",
                        "type": "string"
                    }
                }
            },
            "tests": [
                {
                    "description": "a string is valid",
                    "data": "foo",
                    "valid": true
                },
                {
                    "description": "a non-string is invalid",
                    "data": 1,
                    "valid": false
                }
            ]
        },
        {
            "description": "$ref with only a query",
            "compatibility": "6,<=7",
            "comment": "RFC 3986 5.2.2: a reference with an empty path keeps the base path and replaces the query",
            "schema": {
                "$id": "http://example.com/a.json?x",
                "allOf": [
                    {
                        "$ref": "?y"
                    }
                ],
                "definitions": {
                    "target": {
                        "$id": "http://example.com/a.json?y",
                        "type": "string"
                    }
                }
            },
            "tests": [
                {
                    "description": "a string is valid",
                    "data": "foo",
                    "valid": true
                },
                {
                    "description": "a non-string is invalid",
                    "data": 1,
                    "valid": false
                }
            ]
        },
        {
            "description": "$ref with only a query (id)",
            "compatibility": "=4",
            "comment": "RFC 3986 5.2.2: a reference with an empty path keeps the base path and replaces the query",
            "schema": {
                "id": "http://example.com/a.json?x",
                "allOf": [
                    {
                        "$ref": "?y"
                    }
                ],
                "definitions": {
                    "target": {
                        "id": "http://example.com/a.json?y",
                        "type": "string"
                    }
                }
            },
            "tests": [
                {
                    "description": "a string is valid",
                    "data": "foo",
                    "valid": true
                },
                {
                    "description": "a non-string is invalid",
                    "data": 1,
                    "valid": false
                }
            ]
        },
        {
            "description": "$ref with a network-path reference",
            "compatibility": "6,<=7",
            "comment": "RFC 3986 5.2.2: a reference starting with \"//\" keeps only the scheme of the base URI",
            "schema": {
                "$id": "http://example.com/a.json",
                "allOf": [
                    {
                        "$ref": "//other.example.com/b.json"
                    }
                ],
                "definitions": {
                    "target": {
                        "$id": "http://other.example.com/b.json",
                        "type": "string"
                    }
                }
            },
            "tests": [
                {
                    "description": "a string is valid",
                    "data": "foo",
                    "valid": true
                },
                {
                    "description": "a non-string is invalid",
                    "data": 1,
                    "valid": false
                }
            ]
        },
        {
            "description": "$ref with a network-path reference (id)",
            "compatibility": "=4",
            "comment": "RFC 3986 5.2.2: a reference starting with \"//\" keeps only the scheme of the base URI",
            "schema": {
                "id": "http://example.com/a.json",
                "allOf": [
                    {
                        "$ref": "//other.example.com/b.json"
                    }
                ],
                "definitions": {
                    "target": {
                        "id": "http://other.example.com/b.json",
                        "type": "string"
                    }
                }
            },
            "tests": [
                {
                    "description": "a string is valid",
                    "data": "foo",
                    "valid": true
                },
                {
                    "description": "a non-string is invalid",
                    "data": 1,
                    "valid": false
                }
            ]
        },
        {
            "description": "$ref against a base URI with an authority and an empty path",
            "compatibility": "6,<=7",
            "comment": "RFC 3986 5.2.3: merging with an empty base path that has an authority starts the path with \"/\"; normalizing the base to \"http://example.com/\" first gives the same result",
            "schema": {
                "$id": "http://example.com",
                "allOf": [
                    {
                        "$ref": "foo.json"
                    }
                ],
                "definitions": {
                    "target": {
                        "$id": "http://example.com/foo.json",
                        "type": "string"
                    }
                }
            },
            "tests": [
                {
                    "description": "a string is valid",
                    "data": "foo",
                    "valid": true
                },
                {
                    "description": "a non-string is invalid",
                    "data": 1,
                    "valid": false
                }
            ]
        },
        {
            "description": "$ref against a base URI with an authority and an empty path (id)",
            "compatibility": "=4",
            "comment": "RFC 3986 5.2.3: merging with an empty base path that has an authority starts the path with \"/\"; normalizing the base to \"http://example.com/\" first gives the same result",
            "schema": {
                "id": "http://example.com",
                "allOf": [
                    {
                        "$ref": "foo.json"
                    }
                ],
                "definitions": {
                    "target": {
                        "id": "http://example.com/foo.json",
                        "type": "string"
                    }
                }
            },
            "tests": [
                {
                    "description": "a string is valid",
                    "data": "foo",
                    "valid": true
                },
                {
                    "description": "a non-string is invalid",
                    "data": 1,
                    "valid": false
                }
            ]
        }
    ]
}
