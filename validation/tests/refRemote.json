{
    "$schema": "../validation-test-schema.json",
    "description": "refRemote validation",
    "tests": [
        {
            "description": "remote ref",
            "schema": { "$ref": "http://localhost:1234/integer.json" },
            "externalSchemas": {
                "http://localhost:1234/integer.json": {
                    "type": "integer"
                }
            },
            "tests": [
                {
                    "description": "remote ref valid",
                    "data": 1,
                    "valid": true
                },
                {
                    "description": "remote ref invalid",
                    "data": "a",
                    "valid": false
                }
            ]
        },
        {
            "description": "fragment within remote ref",
            "compatibility": "2019",
            "schema": { "$ref": "http://localhost:1234/subSchemas.json#/$defs/integer" },
            "externalSchemas": {
                "http://localhost:1234/subSchemas.json": {
                    "$defs": {
                        "integer": {
                            "type": "integer"
                        }
                    }
                }
            },
            "tests": [
                {
                    "description": "remote fragment valid",
                    "data": 1,
                    "valid": true
                },
                {
                    "description": "remote fragment invalid",
                    "data": "a",
                    "valid": false
                }
            ]
        },
        {
            "description": "ref within remote ref",
            "compatibility": "2019",
            "schema": { "$ref": "http://localhost:1234/subSchemas.json#/$defs/refToInteger" },
            "externalSchemas": {
                "http://localhost:1234/subSchemas.json": {
                    "$defs": {
                        "integer": {
                            "type": "integer"
                        },
                        "refToInteger": {
                            "$ref": "#/$defs/integer"
                        }
                    }
                }
            },
            "tests": [
                {
                    "description": "ref within ref valid",
                    "data": 1,
                    "valid": true
                },
                {
                    "description": "ref within ref invalid",
                    "data": "a",
                    "valid": false
                }
            ]
        },
        {
            "description": "base URI change",
            "compatibility": "6",
            "schema": {
                "$id": "http://localhost:1234/",
                "items": {
                    "$id": "baseUriChange/",
                    "items": { "$ref": "folderInteger.json" }
                }
            },
            "externalSchemas": {
                "http://localhost:1234/baseUriChange/folderInteger.json": {
                    "type": "integer"
                }
            },
            "tests": [
                {
                    "description": "base URI change ref valid",
                    "data": [[1]],
                    "valid": true
                },
                {
                    "description": "base URI change ref invalid",
                    "data": [["a"]],
                    "valid": false
                }
            ]
        },
        {
            "description": "base URI change - change folder",
            "compatibility": "2019",
            "schema": {
                "$id": "http://localhost:1234/scope_change_defs1.json",
                "type" : "object",
                "properties": {
                    "list": { "$ref": "baseUriChangeFolder/" }
                },
                "$defs": {
                    "baz": {
                        "$id": "baseUriChangeFolder/",
                        "type": "array",
                        "items": { "$ref": "folderInteger.json" }
                    }
                }
            },
            "externalSchemas": {
                "http://localhost:1234/baseUriChangeFolder/folderInteger.json": {
                    "type": "integer"
                }
            },
            "tests": [
                {
                    "description": "number is valid",
                    "data": { "list": [1] },
                    "valid": true
                },
                {
                    "description": "string is invalid",
                    "data": { "list": ["a"] },
                    "valid": false
                }
            ]
        },
        {
            "description": "base URI change - change folder in subschema",
            "compatibility": "2019",
            "schema": {
                "$id": "http://localhost:1234/scope_change_defs2.json",
                "type" : "object",
                "properties": {
                    "list": { "$ref": "baseUriChangeFolderInSubschema/#/$defs/bar" }
                },
                "$defs": {
                    "baz": {
                        "$id": "baseUriChangeFolderInSubschema/",
                        "$defs": {
                            "bar": {
                                "type": "array",
                                "items": { "$ref": "folderInteger.json" }
                            }
                        }
                    }
                }
            },
            "externalSchemas": {
                "http://localhost:1234/baseUriChangeFolderInSubschema/folderInteger.json": {
                    "type": "integer"
                }
            },
            "tests": [
                {
                    "description": "number is valid",
                    "data": { "list": [1] },
                    "valid": true
                },
                {
                    "description": "string is invalid",
                    "data": { "list": ["a"] },
                    "valid": false
                }
            ]
        },
        {
            "description": "root ref in remote ref",
            "compatibility": "2019",
            "schema": {
                "$id": "http://localhost:1234/object",
                "type": "object",
                "properties": {
                    "name": { "$ref": "name-defs.json#/$defs/orNull" }
                }
            },
            "externalSchemas": {
                "http://localhost:1234/name-defs.json": {
                    "$defs": {
                        "orNull": {
                            "anyOf": [
                                { "type": "null" },
                                { "$ref": "#" }
                            ]
                        }
                    },
                    "type": "string"
                }
            },
            "tests": [
                {
                    "description": "string is valid",
                    "data": { "name": "foo" },
                    "valid": true
                },
                {
                    "description": "null is valid",
                    "data": { "name": null },
                    "valid": true
                },
                {
                    "description": "object is invalid",
                    "data": { "name": { "name": null } },
                    "valid": false
                }
            ]
        },
        {
            "description": "remote ref with ref to defs",
            "compatibility": "2019",
            "schema": {
                "$id": "http://localhost:1234/schema-remote-ref-ref-defs1.json",
                "$ref": "ref-and-defs.json"
            },
            "externalSchemas": {
                "http://localhost:1234/ref-and-defs.json": {
                    "$defs": {
                        "inner": {
                            "properties": {
                                "bar": { "type": "string" }
                            }
                        }
                    },
                    "$ref": "#/$defs/inner"
                }
            },
            "tests": [
                {
                    "description": "invalid",
                    "data": { "bar": 1 },
                    "valid": false
                },
                {
                    "description": "valid",
                    "data": { "bar": "a" },
                    "valid": true
                }
            ]
        },
        {
            "description": "retrieved nested refs resolve relative to their URI not $id",
            "compatibility": "6",
            "schema": {
                "$id": "http://localhost:1234/some-id",
                "properties": {
                    "name": { "$ref": "nested/foo-ref-string.json" }
                }
            },
            "externalSchemas": {
                "http://localhost:1234/nested/foo-ref-string.json": {
                    "type": "object",
                    "properties": {
                        "foo": { "$ref": "string.json" }
                    }
                }
            },
            "tests": [
                {
                    "description": "number is invalid",
                    "data": { "name": { "foo":  1} },
                    "valid": false
                },
                {
                    "description": "string is valid",
                    "data": { "name": { "foo":  "a"} },
                    "valid": true
                }
            ]
        },
        {
            "description": "$ref to $ref finds location-independent $id",
            "compatibility": "6,<=7",
            "schema": { "$ref": "http://localhost:1234/detached-ref.json#/definitions/foo" },
            "externalSchemas": {
                "http://localhost:1234/detached-ref.json": {
                    "definitions": {
                        "foo": {
                            "$ref": "#detached"
                        },
                        "detached": {
                            "$id": "#detached",
                            "type": "integer"
                        }
                    }
                }
            },
            "tests": [
                {
                    "description": "number is valid",
                    "data": 1,
                    "valid": true
                },
                {
                    "description": "non-number is invalid",
                    "data": "a",
                    "valid": false
                }
            ]
        },
        {
            "description": "remote HTTP ref with different $id",
            "compatibility": "2019",
            "schema": { "$ref": "http://localhost:1234/different-id-ref-string.json" },
            "externalSchemas": {
                "http://localhost:1234/different-id-ref-string.json": {
                    "$defs": {
                        "bar": { "type": "string" }
                    },
                    "$ref": "#/$defs/bar"
                }
            },  
            "tests": [
                {
                    "description": "number is invalid",
                    "data": 1,
                    "valid": false
                },
                {
                    "description": "string is valid",
                    "data": "foo",
                    "valid": true
                }
            ]
        },
        {
            "description": "remote HTTP ref with different URN $id",
            "compatibility": "2019",
            "schema": { "$ref": "http://localhost:1234/urn-ref-string.json" },
            "externalSchemas": {
                "http://localhost:1234/urn-ref-string.json": {
                    "$defs": {
                        "bar": { "type": "string" }
                    },
                    "$ref": "#/$defs/bar"
                }
            },
            "tests": [
                {
                    "description": "number is invalid",
                    "data": 1,
                    "valid": false
                },
                {
                    "description": "string is valid",
                    "data": "foo",
                    "valid": true
                }
            ]
        },
        {
            "description": "remote HTTP ref with nested absolute ref",
            "compatibility": "2019",
            "schema": { "$ref": "http://localhost:1234/nested-absolute-ref-to-string.json" },
            "externalSchemas": {
                "http://localhost:1234/nested-absolute-ref-to-string.json": {
                    "$defs": {
                        "bar": {
                            "$id": "http://localhost:1234/the-nested-id.json",
                            "type": "string"
                        }
                    },
                    "$ref": "http://localhost:1234/the-nested-id.json"
                }
            },
            "tests": [
                {
                    "description": "number is invalid",
                    "data": 1,
                    "valid": false
                },
                {
                    "description": "string is valid",
                    "data": "foo",
                    "valid": true
                }
            ]
        }
    ]
}
