{
    "$schema": "../../validation-test-schema.json",
    "description": "optional bignum validation",
    "comment": "Optional because it requires support for numeric values that typical native representations cannot handle, such as arbitrarily large (bignum) integers, high-precision floats, and floating-point values that overflow typical number representations.",
    "tests": [
        {
            "description": "integer",
            "schema": {
                "type": "integer"
            },
            "tests": [
                {
                    "description": "a bignum is an integer",
                    "data": 12345678910111213141516171819202122232425262728293031,
                    "valid": true
                },
                {
                    "description": "a negative bignum is an integer",
                    "data": -12345678910111213141516171819202122232425262728293031,
                    "valid": true
                }
            ]
        },
        {
            "description": "number",
            "schema": {
                "type": "number"
            },
            "tests": [
                {
                    "description": "a bignum is a number",
                    "data": 98249283749234923498293171823948729348710298301928331,
                    "valid": true
                },
                {
                    "description": "a negative bignum is a number",
                    "data": -98249283749234923498293171823948729348710298301928331,
                    "valid": true
                }
            ]
        },
        {
            "description": "string",
            "schema": {
                "type": "string"
            },
            "tests": [
                {
                    "description": "a bignum is not a string",
                    "data": 98249283749234923498293171823948729348710298301928331,
                    "valid": false
                }
            ]
        },
        {
            "description": "maximum integer comparison",
            "schema": {
                "maximum": 18446744073709551615
            },
            "tests": [
                {
                    "description": "comparison works for high numbers",
                    "data": 18446744073709551600,
                    "valid": true
                },
                {
                    "description": "just above the maximum is invalid",
                    "data": 18446744073709551616,
                    "valid": false
                }
            ]
        },
        {
            "description": "float comparison with high precision (boolean)",
            "compatibility": "<=4",
            "schema": {
                "maximum": 972783798187987123879878123.18878137,
                "exclusiveMaximum": true
            },
            "tests": [
                {
                    "description": "below the exclusive maximum is valid",
                    "data": 972783798187987123879878123.188781369,
                    "valid": true
                },
                {
                    "description": "comparison works for high numbers",
                    "data": 972783798187987123879878123.188781371,
                    "valid": false
                }
            ]
        },
        {
            "description": "float comparison with high precision",
            "compatibility": "6",
            "schema": {
                "exclusiveMaximum": 972783798187987123879878123.18878137
            },
            "tests": [
                {
                    "description": "below the exclusive maximum is valid",
                    "data": 972783798187987123879878123.188781369,
                    "valid": true
                },
                {
                    "description": "comparison works for high numbers",
                    "data": 972783798187987123879878123.188781371,
                    "valid": false
                }
            ]
        },
        {
            "description": "minimum integer comparison",
            "schema": {
                "minimum": -18446744073709551615
            },
            "tests": [
                {
                    "description": "comparison works for very negative numbers",
                    "data": -18446744073709551600,
                    "valid": true
                },
                {
                    "description": "just below the minimum is invalid",
                    "data": -18446744073709551616,
                    "valid": false
                }
            ]
        },
        {
            "description": "float comparison with high precision on negative numbers (boolean)",
            "compatibility": "<=4",
            "schema": {
                "minimum": -972783798187987123879878123.18878137,
                "exclusiveMinimum": true
            },
            "tests": [
                {
                    "description": "above the exclusive minimum is valid",
                    "data": -972783798187987123879878123.188781369,
                    "valid": true
                },
                {
                    "description": "comparison works for very negative numbers",
                    "data": -972783798187987123879878123.188781371,
                    "valid": false
                }
            ]
        },
        {
            "description": "float comparison with high precision on negative numbers",
            "compatibility": "6",
            "schema": {
                "exclusiveMinimum": -972783798187987123879878123.18878137
            },
            "tests": [
                {
                    "description": "above the exclusive minimum is valid",
                    "data": -972783798187987123879878123.188781369,
                    "valid": true
                },
                {
                    "description": "comparison works for very negative numbers",
                    "data": -972783798187987123879878123.188781371,
                    "valid": false
                }
            ]
        },
        {
            "description": "enum comparison with high precision",
            "schema": {
                "enum": [0.123456789123456789]
            },
            "tests": [
                {
                    "description": "the exact decimal is valid",
                    "data": 0.123456789123456789,
                    "valid": true
                },
                {
                    "description": "a slightly smaller decimal is invalid",
                    "data": 0.123456789123456788,
                    "valid": false
                },
                {
                    "description": "a slightly larger decimal is invalid",
                    "data": 0.123456789123456790,
                    "valid": false
                }
            ]
        },
        {
            "description": "const comparison with high precision",
            "compatibility": "6",
            "schema": {
                "const": 0.123456789123456789
            },
            "tests": [
                {
                    "description": "the exact decimal is valid",
                    "data": 0.123456789123456789,
                    "valid": true
                },
                {
                    "description": "a slightly smaller decimal is invalid",
                    "data": 0.123456789123456788,
                    "valid": false
                },
                {
                    "description": "a slightly larger decimal is invalid",
                    "data": 0.123456789123456790,
                    "valid": false
                }
            ]
        },
        {
            "description": "all integers are multiples of 0.5, if overflow is handled",
            "compatibility": "4",
            "schema": {
                "type": "number",
                "multipleOf": 0.5
            },
            "tests": [
                {
                    "description": "valid if optional overflow handling is implemented",
                    "data": 1e308,
                    "valid": true
                }
            ]
        },
        {
            "description": "uniqueItems comparison with high precision",
            "schema": {
                "uniqueItems": true
            },
            "tests": [
                {
                    "description": "distinct high-precision decimals are unique",
                    "data": [0.123456789123456789, 0.123456789123456790],
                    "valid": true
                },
                {
                    "description": "the same high-precision decimal is not unique",
                    "data": [0.123456789123456789, 0.123456789123456789],
                    "valid": false
                },
                {
                    "description": "trailing zeroes do not make decimals unique",
                    "data": [0.123456789123456789, 0.1234567891234567890],
                    "valid": false
                },
                {
                    "description": "arrays containing distinct decimals are unique",
                    "data": [[0.123456789123456789], [0.123456789123456790]],
                    "valid": true
                },
                {
                    "description": "arrays containing the same decimal are not unique",
                    "data": [[0.123456789123456789], [0.123456789123456789]],
                    "valid": false
                },
                {
                    "description": "objects containing distinct decimals are unique",
                    "data": [{"value": 0.123456789123456789}, {"value": 0.123456789123456790}],
                    "valid": true
                },
                {
                    "description": "objects containing the same decimal are not unique",
                    "data": [{"value": 0.123456789123456789}, {"value": 0.123456789123456789}],
                    "valid": false
                }
            ]
        },
        {
            "description": "multipleOf with integers above 2^53",
            "comment": "Both instances are exact as doubles, but dividing by 3 rounds the quotient to an integer, so the check must not rely on the quotient",
            "compatibility": "4",
            "schema": {
                "multipleOf": 3
            },
            "tests": [
                {
                    "description": "3e20 is multiple of 3",
                    "data": 300000000000000000000,
                    "valid": true
                },
                {
                    "description": "1e20 is not multiple of 3",
                    "data": 100000000000000000000,
                    "valid": false
                }
            ]
        },
        {
            "description": "divisibleBy with integers above 2^53",
            "comment": "Both instances are exact as doubles, but dividing by 3 rounds the quotient to an integer, so the check must not rely on the quotient",
            "compatibility": "=3",
            "schema": {
                "divisibleBy": 3
            },
            "tests": [
                {
                    "description": "3e20 is divisible by 3",
                    "data": 300000000000000000000,
                    "valid": true
                },
                {
                    "description": "1e20 is not divisible by 3",
                    "data": 100000000000000000000,
                    "valid": false
                }
            ]
        }
    ]
}
