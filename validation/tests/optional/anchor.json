{
    "$schema": "../../validation-test-schema.json",
    "description": "optional anchor validation",
    "tests": [
        {
            "description": "anchor inside an enum is not a real identifier ($anchor)",
            "compatibility": "2019",
            "comment": "the implementation must not be confused by an $anchor buried in the enum",
            "schema": {
                "$defs": {
                    "anchor_in_enum": {
                        "enum": [
                            {
                                "$anchor": "my_anchor",
                                "type": "null"
                            }
                        ]
                    },
                    "real_identifier_in_schema": {
                        "$anchor": "my_anchor",
                        "type": "string"
                    },
                    "zzz_anchor_in_const": {
                        "const": {
                            "$anchor": "my_anchor",
                            "type": "null"
                        }
                    }
                },
                "anyOf": [
                    { "$ref": "#/$defs/anchor_in_enum" },
                    { "$ref": "#my_anchor" }
                ]
            },
            "tests": [
                {
                    "description": "exact match to enum, and type matches",
                    "data": { "$anchor": "my_anchor", "type": "null" },
                    "valid": true
                },
                {
                    "description": "implementations that strip $anchor may match either definition",
                    "data": { "type": "null" },
                    "valid": false
                },
                {
                    "description": "match $ref to $anchor",
                    "data": "a string to match #/$defs/anchor_in_enum",
                    "valid": true
                },
                {
                    "description": "no match on enum or $ref to $anchor",
                    "data": 1,
                    "valid": false
                }
            ]
        },
        {
            "description": "anchor inside an enum is not a real identifier ($id)",
            "compatibility": "6,<=7",
            "comment": "the implementation must not be confused by an $anchor buried in the enum",
            "schema": {
                "definitions": {
                    "anchor_in_enum": {
                        "enum": [
                            {
                                "$id": "#my_anchor",
                                "type": "null"
                            }
                        ]
                    },
                    "real_identifier_in_schema": {
                        "$id": "#my_anchor",
                        "type": "string"
                    },
                    "zzz_anchor_in_const": {
                        "const": {
                            "$id": "#my_anchor",
                            "type": "null"
                        }
                    }
                },
                "anyOf": [
                    { "$ref": "#/definitions/anchor_in_enum" },
                    { "$ref": "#my_anchor" }
                ]
            },
            "tests": [
                {
                    "description": "exact match to enum, and type matches",
                    "data": { "$id": "#my_anchor", "type": "null" },
                    "valid": true
                },
                {
                    "description": "implementations that strip $id may match either definition",
                    "data": { "type": "null" },
                    "valid": false
                },
                {
                    "description": "match $ref to $id",
                    "data": "a string to match #/definitions/anchor_in_enum",
                    "valid": true
                },
                {
                    "description": "no match on enum or $ref to $id",
                    "data": 1,
                    "valid": false
                }
            ]
        },
        {
            "description": "anchor inside an enum is not a real identifier (id)",
            "compatibility": "=4",
            "comment": "the implementation must not be confused by an $anchor buried in the enum",
            "schema": {
                "definitions": {
                    "anchor_in_enum": {
                        "enum": [
                            {
                                "id": "#my_anchor",
                                "type": "null"
                            }
                        ]
                    },
                    "real_identifier_in_schema": {
                        "id": "#my_anchor",
                        "type": "string"
                    },
                    "zzz_anchor_in_const": {
                        "enum": [
                            {
                                "id": "#my_anchor",
                                "type": "null"
                            }
                        ]
                    }
                },
                "anyOf": [
                    { "$ref": "#/definitions/anchor_in_enum" },
                    { "$ref": "#my_anchor" }
                ]
            },
            "tests": [
                {
                    "description": "exact match to enum, and type matches",
                    "data": { "id": "#my_anchor", "type": "null" },
                    "valid": true
                },
                {
                    "description": "implementations that strip id may match either definition",
                    "data": { "type": "null" },
                    "valid": false
                },
                {
                    "description": "match $ref to $anchor",
                    "data": "a string to match #/definitions/anchor_in_enum",
                    "valid": true
                },
                {
                    "description": "no match on enum or $ref to id",
                    "data": 1,
                    "valid": false
                }
            ]
        }
    ]
}
