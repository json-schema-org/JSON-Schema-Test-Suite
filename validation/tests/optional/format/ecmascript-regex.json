{
    "$schema": "../../../validation-test-schema.json",
    "description": "optional format ecmascript-regex validation",
    "tests": [
        {
            "description": "ECMA 262 regex dialect recognition",
            "compatibility": "<=3",
            "schema": {
                "format": "regex"
            },
            "tests": [
                {
                    "description": "[^] is a valid regex",
                    "data": "[^]",
                    "valid": true
                },
                {
                    "description": "ECMA 262 supports lookbehind since ES2018",
                    "data": "(?<=foo)bar",
                    "valid": true
                },
                {
                    "description": "ECMA 262 does not support Python-style named groups",
                    "data": "(?P<name>x)",
                    "valid": false
                }
            ]
        },
        {
            "description": "\\a is not an ECMA 262 control escape",
            "compatibility": "=2020",
            "schema": {
                "format": "regex"
            },
            "tests": [
                {
                    "description": "when used as a pattern",
                    "data": "\\a",
                    "valid": false
                }
            ]
        }
    ]
}
