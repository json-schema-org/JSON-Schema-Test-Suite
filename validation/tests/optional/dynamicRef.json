{
    "$schema": "../../validation-test-schema.json",
    "description": "optional dynamicRef validation",
    "comment": "Optional because the spec does not clearly define how $dynamicRef interacts with the dynamic scope when a reference jumps over (skips) an intermediate schema resource. Implementations differ on whether the intermediate resource is included in the dynamic scope, so the two interpretations in this file produce different results and neither is guaranteed by the spec.",
    "tests": [
        {
            "description": "$dynamicRef skips over intermediate resources - pointer reference across resource boundary",
            "compatibility": "9999",
            "schema": {
                "$id": "https://test.json-schema.org/dynamic-ref-skips-intermediate-resource/optional/main",
                "type": "object",
                "properties": {
                    "bar-item": { "$ref": "bar#/$defs/item" }
                },
                "$defs": {
                    "bar": {
                        "$id": "bar",
                        "type": "array",
                        "items": { "$ref": "item" },
                        "$defs": {
                            "item": {
                                "$id": "item",
                                "type": "object",
                                "properties": {
                                    "content": { "$dynamicRef": "content" }
                                },
                                "$defs": {
                                    "defaultContent": {
                                        "$dynamicAnchor": "content",
                                        "type": "integer"
                                    }
                                }
                            },
                            "content": {
                                "$dynamicAnchor": "content",
                                "type": "string"
                            }
                        }
                    }
                }
            },
            "tests": [
                {
                    "description": "integer property passes",
                    "data": { "bar-item": { "content": 42 } },
                    "valid": true
                },
                {
                    "description": "string property fails",
                    "data": { "bar-item": { "content": "value" } },
                    "valid": false
                }
            ]
        },
        {
            "description": "$dynamicRef skips over intermediate resources - pointer reference across resource boundary (2020)",
            "compatibility": "=2020",
            "schema": {
                "$id": "https://test.json-schema.org/dynamic-ref-skips-intermediate-resource/optional/main",
                "type": "object",
                "properties": {
                    "bar-item": { "$ref": "bar#/$defs/item" }
                },
                "$defs": {
                    "bar": {
                        "$id": "bar",
                        "type": "array",
                        "items": { "$ref": "item" },
                        "$defs": {
                            "item": {
                                "$id": "item",
                                "type": "object",
                                "properties": {
                                    "content": { "$dynamicRef": "#content" }
                                },
                                "$defs": {
                                    "defaultContent": {
                                        "$dynamicAnchor": "content",
                                        "type": "integer"
                                    }
                                }
                            },
                            "content": {
                                "$dynamicAnchor": "content",
                                "type": "string"
                            }
                        }
                    }
                }
            },
            "tests": [
                {
                    "description": "integer property passes",
                    "data": { "bar-item": { "content": 42 } },
                    "valid": true
                },
                {
                    "description": "string property fails",
                    "data": { "bar-item": { "content": "value" } },
                    "valid": false
                }
            ]
        }
    ]
}
